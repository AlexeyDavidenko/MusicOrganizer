<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganizer.Gui.ViewModels"
             xmlns:journal="using:MusicOrganizer.Domain.Journal"
             x:Class="MusicOrganizer.Gui.Views.RollbackView"
             x:DataType="vm:RollbackViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Rollback" FontSize="20" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap"
                   Text="Restores every file changed by a previous --apply run, in reverse-chronological order. Pick a recorded run below, or enter its run id directly." />

        <Button Content="Refresh runs" Command="{Binding RefreshRunsCommand}" HorizontalAlignment="Left" />

        <ListBox ItemsSource="{Binding AvailableRuns}" SelectedItem="{Binding SelectedRun}" Height="160">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="journal:JournalRunSummary">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding RunId}" />
                        <TextBlock Grid.Column="1" Text="{Binding LastActivityAtUtc}" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding EntryCount, StringFormat='{}{0} entry(ies)'}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox Text="{Binding RunIdText}" PlaceholderText="...or enter a run id directly" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Rollback" Command="{Binding RunCommand}" />
            <Button Content="Cancel" Command="{Binding RunCancelCommand}" />
            <Button Content="Save results…" Click="OnSaveResultsClick" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Results}" Height="300">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="journal:JournalEntry">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding OperationType}" Margin="8,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
