<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganizer.Gui.ViewModels"
             xmlns:recovery="using:MusicOrganizer.Domain.TagRecovery"
             xmlns:conv="using:MusicOrganizer.Gui.Converters"
             x:Class="MusicOrganizer.Gui.Views.RecoverTagsView"
             x:DataType="vm:RecoverTagsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Recover Tags" FontSize="20" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap"
                   Text="Recovers missing Artist/Title/Album tags using the 8-level priority chain (ID3, filename, folder structure, collection statistics, heuristics)." />

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseFolderClick" Margin="8,0,0,0" />
            <TextBox Text="{Binding RootPath}" PlaceholderText="Root folder to scan" />
        </DockPanel>

        <CheckBox Content="Apply (write changes)" IsChecked="{Binding Apply}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Run" Command="{Binding RunCommand}" />
            <Button Content="Cancel" Command="{Binding RunCancelCommand}" />
            <Button Content="Save results…" Click="OnSaveResultsClick" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding LastRunId, StringFormat='Run id: {0}'}" />

        <ListBox ItemsSource="{Binding Results}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="recovery:TagRecoveryOutcome">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding RecoveredFields, Converter={x:Static conv:StringListConverter.Instance}}" />
                            <TextBlock Text="Applied" IsVisible="{Binding Applied}" Foreground="Green" />
                            <TextBlock Text="{Binding Error}" Foreground="Red" />
                            <TextBlock Text="Manual review needed" IsVisible="{Binding NeedsManualReview}" Foreground="DarkOrange" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
