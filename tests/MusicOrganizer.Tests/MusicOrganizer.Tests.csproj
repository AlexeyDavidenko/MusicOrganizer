<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CA1707: underscore_separated test names (MethodUnderTest_Scenario_Expected) are the
         project's deliberate xUnit naming convention, not an oversight.
         CA1716: the Unit/Shared test folder mirrors the MusicOrganizer.Shared project it tests;
         "Shared" is a reserved VB.NET keyword, out of scope for this C#-only project. -->
    <NoWarn>$(NoWarn);CA1707;CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MusicOrganizer.Domain\MusicOrganizer.Domain.csproj" />
    <ProjectReference Include="..\..\src\MusicOrganizer.Application\MusicOrganizer.Application.csproj" />
    <ProjectReference Include="..\..\src\MusicOrganizer.Infrastructure\MusicOrganizer.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MusicOrganizer.Shared\MusicOrganizer.Shared.csproj" />
    <ProjectReference Include="..\..\src\MusicOrganizer.Cli\MusicOrganizer.Cli.csproj" />
  </ItemGroup>

</Project>